# Your Prismic repository name (from https://your-repo.prismic.io)
NEXT_PUBLIC_PRISMIC_ENVIRONMENT=your-repo-name

# Secret used by the Prismic webhook to revalidate pages (set the same value in Prismic > Settings > Webhooks)
PRISMIC_REVALIDATE_SECRET=change-me

# Canonical site URL (used for sitemap, robots, OG tags)
NEXT_PUBLIC_SITE_URL=https://your-site.com
NEXT_PUBLIC_BASE_PATH=/your-base-path

# EmailJS Configuration (from https://www.emailjs.com/)
NEXT_PUBLIC_EJ_SERVICE_ID=your_service_id
NEXT_PUBLIC_EJ_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EJ_PUBLIC_KEY=your_public_key
